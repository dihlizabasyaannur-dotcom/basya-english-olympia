{
  "name": "basya-english-olympia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "supabase db reset && node scripts/test-db.mjs",
    "content:build": "node scripts/build-starter-content.mjs",
    "db:reset": "supabase db reset",
    "test:e2e": "node scripts/e2e-student.mjs && node scripts/e2e-admin.mjs",
    "db:bundle": "node -e \"const fs=require('fs');const fl=fs.readdirSync('supabase/migrations').sort();fs.writeFileSync('supabase/production-setup.sql','-- BASYA ENGLISH OLYMPIA — complete database setup (generated by: npm run db:bundle)\\n-- Paste this whole file into Supabase Dashboard → SQL Editor → Run. Run it only ONCE on a new project.\\n'+fl.map(f=>'\\n-- ===== supabase/migrations/'+f+' =====\\n'+fs.readFileSync('supabase/migrations/'+f,'utf8')).join(''))\""
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "supabase": "^3.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
