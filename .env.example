# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase Dashboard → Project Settings → API
#
# Both values are PUBLIC by design (they are sent to the browser). Security comes from
# Row Level Security in the database. NEVER put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
